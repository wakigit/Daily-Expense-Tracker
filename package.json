{
  "name": "daily-expense-tracker",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "vite build --ssr scripts/smoke.jsx --outDir .smoke-build --logLevel error && node .smoke-build/smoke.js",
    "eval": "vite build --ssr scripts/eval/run.mjs --outDir .eval-build --logLevel error && node .eval-build/run.js",
    "eval:self-check": "node scripts/eval/self-check.mjs",
    "eval:fixture-checks": "node scripts/eval/fixture-checks.mjs"
  },
  "dependencies": {
    "openai": "^7.28.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1"
  }
}
