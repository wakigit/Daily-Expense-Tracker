# Copy to .env and fill in. .env is git-ignored; this file is not, so it must
# never contain a real value — only the names of the variables and what they are.
#
#   cp .env.example .env
#   npm run verify        # is the key accepted, is the model available?
#   npm run verify:live   # one real request, end to end
#
# The npm scripts load this file themselves (Node 20.12+). There is no flag to
# remember and nothing breaks when the file is absent.

# Port and interface for the server. Defaults are 8787 and 127.0.0.1.
PORT=8787
HOST=127.0.0.1

# Browser origins allowed to call this server, comma separated. No wildcard.
# ALLOWED_ORIGINS=http://localhost:5173,https://wakigit.github.io

# ── OpenAI ────────────────────────────────────────────────────────────────
# The key is read by the SERVER only, through process.env, and is never sent to
# the browser. Never prefix it with VITE_: Vite inlines every VITE_* variable
# into the client bundle, and this repo publishes that bundle publicly. A key
# that reaches the browser is a public key the moment it ships.
OPENAI_API_KEY=

# Which model to use. Change it here rather than in code.
OPENAI_MODEL=gpt-4.1-mini
